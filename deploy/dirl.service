[Unit]
Description=Dirl web SSH client
After=network-online.target
Wants=network-online.target

[Service]
# A user that exists only while Dirl runs, nobody has to create one. Its data lives in /var/lib/dirl, which systemd
# creates with mode 0700 (behind it /var/lib/private/dirl, which no other user can enter).
DynamicUser=yes
StateDirectory=dirl
StateDirectoryMode=0700
WorkingDirectory=/var/lib/dirl
# The config stays root's own file. systemd hands Dirl a read-only copy in unswappable memory that only Dirl can read.
LoadCredential=config.json:/etc/dirl/config.json
# Key file mode: enable this line and set "keyFile": "/run/credentials/dirl.service/kek" in the config.
#LoadCredential=kek:/etc/dirl/kek
ExecStart=/usr/bin/java -Xmx256m -XX:+ExitOnOutOfMemoryError -jar /opt/dirl/dirl.jar config=${CREDENTIALS_DIRECTORY}/config.json
Restart=on-failure
# 78 is a rejected config or a port that cannot be bound, a restart does not fix either.
RestartPreventExitStatus=78
UMask=0077
LimitCORE=0
# The decrypted vault holds the private keys, they must never be written to swap. Needs cgroup v2, ignored without.
MemorySwapMax=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
